      "parameters": {
        "jsCode": "// Ambil teks balasan dari HR via Telegram\nconst hrResponse = $input.first().json.data.text || $input.item.json.text || \"\";\n\n// Split string berdasarkan karakter pipe \"|\"\nconst parts = hrResponse.split('|').map(p => p.trim());\n\nconst interviewDate = parts[0] || \"Akan diinformasikan kembali\";\nconst interviewTime = parts[1] || \"Akan diinformasikan kembali\";\nconst meetingLink = parts[2] || \"https://meet.google.com/\";\n\n// Ambil data kandidat dari item yang sedang diproses\nconst candidate = $input.item.json;\n\nreturn {\n  json: {\n    ...candidate, // Tetap membawa data kandidat sebelumnya\n    interview_date: interviewDate,\n    interview_time: interviewTime,\n    meeting_link: meetingLink\n  }\n};"
      },
