    {
      "parameters": {
        "jsCode": "// Memproses SELURUH kandidat/CV yang mengalir dari node sebelumnya ($input.all())\nreturn $input.all().map((item, index) => {\n  // 1. Ambil data dari Groq Ke-2 (Semantic Matcher) yang masuk sebagai item saat ini\n  let semanticRes = {};\n  try {\n    const rawSemanticContent = item.json.choices[0].message.content;\n    semanticRes = typeof rawSemanticContent === 'string' ? JSON.parse(rawSemanticContent) : rawSemanticContent;\n  } catch (e) {\n    semanticRes = { project_relevance_score: 0, reason: \"Gagal parse semantic response\" };\n  }\n\n  // 2. Ambil data dari Groq Ke-1 (AI Resume Extraction) sesuai indeks item\n  let extractRes = {};\n  try {\n    const extractItem = $(\"Groq - AI Resume Extraction\").all()[index] || $(\"Groq - AI Resume Extraction\").item;\n    const rawExtractContent = extractItem.json.choices[0].message.content;\n    extractRes = typeof rawExtractContent === 'string' ? JSON.parse(rawExtractContent) : rawExtractContent;\n  } catch (e) {\n    extractRes = { name: \"Unknown\", email: \"Unknown\", skills: [], total_experience_years: 0, education_level: \"\" };\n  }\n\n  // 3. Ambil data Job Spec dari Google Sheets\n  const jobSpecItem = $(\"Get row(s) in sheet\").all()[index] || $(\"Get row(s) in sheet\").first() || {};\n  const jobSpec = jobSpecItem.json || {};\n\n  // 4. Ambil Teks CV Mentah (diperbaiki dari typo toLowerCas)\n  const rawCvTextItem = $(\"Extract from File\").all()[index] || $(\"Extract from File\").first() || {};\n  const rawCvText = (rawCvTextItem.json?.text || \"\").toLowerCase();\n\n  // Helper untuk membersihkan array/string\n  const cleanList = (str) => typeof str === 'string' ? str.split(',').map(s => s.trim().toLowerCase()).filter(Boolean) : [];\n\n  // --- A. SKILL MATCH (40%) ---\n  const reqSkills = cleanList(jobSpec.Required_Skills || jobSpec.required_skills);\n  const candSkills = (extractRes.skills || []).map(s => String(s).toLowerCase());\n  let matchedSkillsCount = 0;\n\n  reqSkills.forEach(req => {\n    if (candSkills.some(cs => cs.includes(req) || req.includes(cs))) {\n      matchedSkillsCount++;\n    }\n  });\n  const skillScore = reqSkills.length > 0 ? (matchedSkillsCount / reqSkills.length) * 100 : 0;\n\n  // --- B. EXPERIENCE MATCH (25%) ---\n  const minExp = parseFloat(jobSpec.Min_Experience_Years || jobSpec.min_experience_years) || 0;\n  const candExp = parseFloat(extractRes.total_experience_years) || 0;\n  let expScore = 0;\n  if (minExp === 0) {\n    expScore = 100;\n  } else {\n    expScore = Math.min(100, (candExp / minExp) * 100);\n  }\n\n  // --- C. EDUCATION MATCH (10%) ---\n  const eduHierarchy = {\n    'high school': 1,\n    'diploma': 2,\n    'bachelor': 3,\n    'master': 4,\n    'phd': 5\n  };\n  const reqEduLevel = eduHierarchy[(jobSpec.Min_Education || jobSpec.min_education || '').toLowerCase()] || 3;\n  const candEduLevel = eduHierarchy[(extractRes.education_level || '').toLowerCase()] || 1;\n  const eduScore = candEduLevel >= reqEduLevel ? 100 : (candEduLevel / reqEduLevel) * 100;\n\n  // --- D. PROJECT RELEVANCE (15%) ---\n  const projectScore = Math.min(100, Math.max(0, parseFloat(semanticRes.project_relevance_score) || 0));\n\n  // --- E. KEYWORD MATCH (10%) ---\n  const keywords = cleanList(jobSpec.Keywords || jobSpec.keywords);\n  let matchedKwCount = 0;\n\n  keywords.forEach(kw => {\n    if (rawCvText.includes(kw)) {\n      matchedKwCount++;\n    }\n  });\n  const keywordScore = keywords.length > 0 ? (matchedKwCount / keywords.length) * 100 : 0;\n\n  // --- TOTAL DETERMINISTIC CALCULATED SCORE ---\n  const totalScore = Math.round(\n    (skillScore * 0.40) +\n    (expScore * 0.25) +\n    (eduScore * 0.10) +\n    (projectScore * 0.15) +\n    (keywordScore * 0.10)\n  );\n\n  // Threshold penentuan Strong vs Weak Match\n  const status = totalScore >= 75 ? 'Strong Match' : 'Weak Match';\n\n  return {\n    json: {\n      candidate_name: extractRes.name || 'Unknown',\n      email: extractRes.email || 'Unknown',\n      job_id: jobSpec.Job_ID || jobSpec.job_id || 'N/A',\n      job_title: jobSpec.Job_Title || jobSpec.job_title || 'N/A',\n      total_score: totalScore,\n      status: status,\n      scores_breakdown: {\n        skill_score: Math.round(skillScore),\n        exp_score: Math.round(expScore),\n        edu_score: Math.round(eduScore),\n        project_score: Math.round(projectScore),\n        keyword_score: Math.round(keywordScore)\n      },\n      semantic_reason: semanticRes.reason || '',\n      skills_found: candSkills.join(', ')\n    }\n  };\n});"
      },
