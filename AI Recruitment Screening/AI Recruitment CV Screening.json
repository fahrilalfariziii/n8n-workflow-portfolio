        "jsCode": "// Memproses seluruh item CV dan mempertahankan metadata asli\nreturn $input.all().map(item => {\n  const rawText = item.json.text || \"\";\n\n  const cleanedText = rawText\n    .replace(/[\\r\\n]+/g, \" \")\n    .replace(/\"/g, '\\\\\"')\n    .replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, \"\");\n\n  return {\n    json: {\n      ...item.json, // Tetap membawa Job_ID, Upload CV link, dll.\n      clean_text: cleanedText\n    }\n  };\n});"
      },
