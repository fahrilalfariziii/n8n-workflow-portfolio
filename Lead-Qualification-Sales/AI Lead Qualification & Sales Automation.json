      "parameters": {
        "jsCode": "const responseText = $json.choices[0].message.content;\nconst aiData = JSON.parse(responseText);\nconst previousCleanData = $node[\"Data Standardizer\"].json.clean_data;\n\nreturn {\n  ...previousCleanData,\n  qualification_score: aiData.qualification_score,\n  category: aiData.category,\n  ai_summary: aiData.ai_summary,\n  recommended_action: aiData.recommended_action\n};"
