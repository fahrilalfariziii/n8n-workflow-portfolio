      "parameters": {
        "jsCode": "// Mengambil data dari Webhook (mengecek $json.body terlebih dahulu)\nconst payload = $json.body || $json;\n\n// Function Helpers\nfunction cleanPhone(phone) {\n  if (!phone) return \"\";\n  let cleaned = String(phone).replace(/[^0-9+]/g, '');\n  if (cleaned.startsWith('08')) cleaned = '+628' + cleaned.slice(2);\n  return cleaned;\n}\n\nfunction validateEmail(email) {\n  if (!email) return false;\n  const re = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  return re.test(String(email).trim().toLowerCase());\n}\n\n// Extraction Data (Support baik dari Webhook Body maupun Telegram)\nlet rawName = payload.name || payload.first_name || (payload.from ? `${payload.from.first_name} ${payload.from.last_name || ''}` : \"Unknown\");\nlet rawEmail = payload.email || \"\";\nlet rawPhone = payload.phone || \"\";\nlet message = payload.message || payload.text || \"\";\nlet company = payload.company || \"N/A\";\nlet channel = payload.from ? \"Telegram\" : \"Website Form\";\n\n// Cleaning & Validation\nlet cleanEmailVal = rawEmail ? rawEmail.trim().toLowerCase() : \"\";\nlet cleanPhoneNum = cleanPhone(rawPhone);\nlet isValidEmail = validateEmail(cleanEmailVal);\nlet isValidMessage = (message.trim().length >= 10);\n\nlet isValid = isValidEmail && isValidMessage;\n\nreturn [{\n  json: {\n    is_valid: isValid,\n    clean_data: {\n      full_name: String(rawName).trim(),\n      email: isValidEmail ? cleanEmailVal : null,\n      phone: cleanPhoneNum,\n      company: company,\n      source_channel: channel,\n      raw_message: message\n    },\n    error: !isValidEmail ? \"Invalid Email\" : (!isValidMessage ? \"Message too short\" : null)\n  }\n}];"
      },
