    {
      "parameters": {
        "jsCode": "// 1. Ambil teks JSON dari property \"text\" (bukan choices[0].message.content)\nlet rawContent = $input.first().json.text || \"\";\n\n// 2. Clean-up jika LLM membungkus dengan markdown codeblock (```json ... ```)\nif (rawContent.includes(\"```\")) {\n  rawContent = rawContent.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n}\n\n// 3. Parse string menjadi Object JSON\nlet parsedAI = {};\ntry {\n  parsedAI = JSON.parse(rawContent);\n} catch (e) {\n  // Fallback default jika LLM tidak mengembalikan valid JSON\n  parsedAI = {\n    category: \"Software\",\n    priority: \"P3\",\n    summary: \"Kendala dilaporkan pengguna\",\n    suggested_action: \"Lakukan verifikasi awal kendala pengguna.\",\n    assigned_team: \"Helpdesk General\"\n  };\n}\n\n// 4. Generate Ticket ID Format: IT-YYYY-XXXX\nconst year = new Date().getFullYear();\nconst randomNum = Math.floor(1000 + Math.random() * 9000);\nconst ticketId = `IT-${year}-${randomNum}`;\n\n// 5. Ambil data awal dari Telegram Trigger\nconst telegramTrigger = $('Telegram Trigger').first().json;\nconst telegramChatId = telegramTrigger.message?.chat?.id || telegramTrigger.message?.from?.id;\nconst rawIssue = telegramTrigger.message?.text || \"\";\n\nreturn [{\n  json: {\n    ticket_id: ticketId,\n    telegram_chat_id: telegramChatId,\n    raw_issue: rawIssue,\n    category: parsedAI.category,\n    priority: parsedAI.priority,\n    summary: parsedAI.summary,\n    suggested_action: parsedAI.suggested_action,\n    assigned_team: parsedAI.assigned_team,\n    status: 'OPEN'\n  }\n}];"
      },
